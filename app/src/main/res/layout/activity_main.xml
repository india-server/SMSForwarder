<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F0F12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📨 SMS Forwarder"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure your device"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginBottom="28dp"/>


        <!-- Phone Number -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="+91 XXXXX XXXXX"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>


        <!-- API Endpoint -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Endpoint"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etApiUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="https://example.com/api/messages"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>


        <!-- Device ID -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device ID"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etDeviceId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Device identifier"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>


        <!-- Buttons -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Save Config"
                android:textAllCaps="false"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnCheckPerms"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Check Permissions"
                android:textAllCaps="false"
                android:backgroundTint="#2196F3"
                android:layout_marginStart="6dp"/>

        </LinearLayout>


        <!-- Status Card -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textColor="#777777"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#181A20">


            <!-- SMS Permission -->

            <TextView
                android:id="@+id/tvSmsPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMS Permission&#10;Checking..."
                android:textColor="#AAAAAA"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp"/>


            <!-- Notification Permission -->

            <TextView
                android:id="@+id/tvNotificationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification Permission&#10;Checking..."
                android:textColor="#AAAAAA"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp"/>


            <!-- Service -->

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Checking service..."
                android:textColor="#FFAA00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>


            <!-- General Status -->

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- Footer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS forwarding requires the required Android permissions."
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>
